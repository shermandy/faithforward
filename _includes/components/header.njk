<header>
    <div class="header-main">
    <a href="/"><img src="/assets/images/logo.png" alt="Faith Forward Logo" /></a>
    <h1><a href="/">Faith Forward</a></h1>
    <img id="menu-open" src="/assets/images/menu.svg" alt="Menu Open Button" />
    <img id="menu-close" src="/assets/images/close-menu.svg" alt="Menu Close Button" />
    </div>

    <nav id="menu">
    <ul>
        {% for item in collections.nav | sortByOrder %}
        {% if item.url !== "/" %}
            <li>
            <a href="{{ item.url }}" 
                {% if item.url == page.url %}class="active" aria-current="page"{% endif %}>
                {{ item.data.title }}
            </a>
            </li>
        {% endif %}
        {% endfor %}
    </ul>
    </nav>
</header>