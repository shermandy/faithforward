<div class="media-box media-box--{{ block.image_position | default('left') }} media-box--bg-{{ block.background_color | default('white') }}">
    <div class="media-box__image">
      {% if block.image %}
        <img src="{{ block.image }}" alt="{{ block.image_alt | default(block.heading) }}">
      {% endif %}
    </div>
    
    <div class="media-box__content">
      {% if block.heading %}
        <h3>{{ block.heading }}</h3>
      {% endif %}
      
      {{ block.content | markdown | safe }}
      
      {% if block.button_url and block.button_text %}
        <p>
          <a href="{{ block.button_url }}" class="button {{ block.button_style | default('primary') }}">{{ block.button_text }}</a>
        </p>
      {% endif %}
    </div>
  </div>