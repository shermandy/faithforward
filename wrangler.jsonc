{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faithforward",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
